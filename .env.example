# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Variables (injected automatically by AI Studio Cloud SQL)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# S3 / R2 Compatible Object Storage (Optional external infrastructure)
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET="sharedabba-media-prod"
S3_ACCESS_KEY_ID="YOUR_S3_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="YOUR_S3_SECRET_ACCESS_KEY"
CDN_BASE_URL="https://cdn.sharedabba.example.com"

# Video Advertising VAST 4.2 Provider (Optional external ad network tag)
VAST_AD_TAG_URL="https://pubads.g.doubleclick.net/gampad/ads?sz=640x480&iu=/124319096/external/single_ad_samples"
VAST_VERIFICATION_SECRET="YOUR_VAST_WEBHOOK_SECRET"

# UPI Payout Gateway (RazorpayX / Cashfree Payouts for India UPI withdrawals)
UPI_PAYOUT_PROVIDER="razorpayx"
RAZORPAYX_KEY_ID="YOUR_RAZORPAYX_KEY_ID"
RAZORPAYX_KEY_SECRET="YOUR_RAZORPAYX_KEY_SECRET"
RAZORPAYX_ACCOUNT_NUMBER="YOUR_RAZORPAYX_ACCOUNT_NUMBER"
RAZORPAYX_WEBHOOK_SECRET="YOUR_RAZORPAYX_WEBHOOK_SECRET"

# Transactional Email Service (Resend / Postmark / SMTP)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS="YOUR_RESEND_API_KEY"
EMAIL_FROM="notifications@sharedabba.com"
